# Скопируйте в .env и поправьте при необходимости: cp .env.example .env
# Без .env `docker compose up` тоже работает — значения по умолчанию заданы
# в docker-compose.yml. Сам .env в репозиторий не попадает (SEC5).

APP_ENV=development
APP_VERSION=dev

POSTGRES_USER=antiscam
POSTGRES_PASSWORD=antiscam-local-password
POSTGRES_DB=antiscam
POSTGRES_EXPOSED_PORT=5432

BACKEND_PORT=8080
LOG_LEVEL=info
LOG_FORMAT=json

# В любом окружении, кроме локального, задайте случайное значение от 32
# символов: openssl rand -base64 48
JWT_SECRET=local-development-secret-change-me
JWT_TTL=24h

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Границы уровней безопасности (FR21).
SCORING_THRESHOLD_RESILIENT=80
SCORING_THRESHOLD_ATTENTIVE=60

FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8080
